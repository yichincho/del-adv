{
  "manifest_version": 3,
  "name": "del-adv｜AI 廣告隱藏",
  "version": "0.1.0",
  "description": "在網頁上以規則和 TypeSafe Jev 判定可疑廣告，隱藏視覺干擾內容。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}